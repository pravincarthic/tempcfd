{
  "case": {
    "name": "mach10_130kft_cone7",
    "mach": 10.0,
    "altitude_ft": 130000.0,
    "geometry": "cone",
    "half_angle_deg": 7.0
  },
  "gas": {
    "library": "su2tclib",
    "gas_model": "AIR-7",
    "transport": "WILKE",
    "frozen": false
  },
  "baseflow": {
    "source": "similarity",
    "x_start": 0.30,
    "x_end": 2.00,
    "n_stations": 171,
    "ny": 161,
    "wall_temperature": 1000.0,
    "adiabatic_wall": false,
    "freestream_Y": {"N2": 0.767, "O2": 0.233}
  },
  "physics": {
    "viscous": true,
    "diffusion": true,
    "thermal_nonequilibrium": true,
    "species_floor": 1e-12,
    "trace_threshold": 1e-6
  },
  "wall_bc": {
    "thermal": "isothermal",
    "vibrational": "isothermal",
    "catalytic": "noncatalytic"
  },
  "analysis": {"type": "lpse"},
  "modes": {
    "f_min_hz": 60000.0,
    "f_max_hz": 300000.0,
    "n_frequencies": 384,
    "frequency_spacing": "linear",
    "c_guess": 0.92,
    "schedule": "center_out"
  },
  "pse": {
    "order": 2,
    "nonparallel": true,
    "far_field": "asymptotic",
    "alpha_tol": 1e-8,
    "alpha_iter": 20,
    "stabilize": 0.0,
    "mixed_derivatives": true,
    "energy_norm": "kinetic",
    "i_start": 0,
    "mode_check": true
  },
  "parallel": {"group_size": 1, "threads": 1},
  "output": {
    "directory": "results/mach10_130kft",
    "file": "pse_modes.h5",
    "envelope_csv": "n_factor_envelope.csv",
    "save_baseflow": true
  }
}
